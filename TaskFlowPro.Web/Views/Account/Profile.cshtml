@model TaskFlowPro.Web.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem;">
    <div class="card" style="text-align: center;">
        <div style="width: 120px; height: 120px; border-radius: 50%; background: var(--sidebar-bg); margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; border: 2px solid var(--primary);">
            @if (string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <i class="fas fa-user fa-4x" style="color: var(--text-muted);"></i>
            }
            else
            {
                <img src="@Model.ProfilePictureUrl" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" alt="Profile" />
            }
        </div>
        <h3>@Model.Username</h3>
        <p style="color: var(--text-muted); font-size: 0.875rem;">@Model.Email</p>
        
        <div style="margin-top: 2rem;">
            <label class="btn btn-outline btn-sm" style="cursor: pointer;" id="upload-btn" data-test="upload-profile-btn">
                <i class="fas fa-camera"></i> Change Photo
                <input type="file" style="display: none;" onchange="showToast('Image uploaded successfully! (Mock)', 'success')" />
            </label>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-bottom: 1.5rem;">Update Information</h3>
        <form asp-action="Profile" method="post" id="profile-form">
            <div class="form-group">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" data-test="profile-username-input" />
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" readonly style="opacity: 0.6;" data-test="profile-email-input" />
            </div>

            <hr style="border: 0; border-top: 1px solid var(--border); margin: 2rem 0;" />

            <h3 style="margin-bottom: 1.5rem;">Security</h3>
            <div class="form-group">
                <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                <input asp-for="CurrentPassword" class="form-control" type="password" placeholder="••••••••" data-test="current-password-input" />
            </div>

            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <input asp-for="NewPassword" class="form-control" type="password" placeholder="••••••••" data-test="new-password-input" />
                <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.75rem; color: var(--danger);"></span>
            </div>

            <button type="submit" class="btn btn-primary" id="update-profile-btn" data-test="update-profile-submit">Save Changes</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
