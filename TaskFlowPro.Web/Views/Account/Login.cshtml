@model TaskFlowPro.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-container">
    <div class="card">
        <h2 style="margin-bottom: 1.5rem; text-align: center;">Welcome Back</h2>
        <form asp-action="Login" method="post" id="login-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem; font-size: 0.875rem; color: var(--danger);"></div>
            
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" id="email-input" data-test="email-input" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.75rem; color: var(--danger);"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" id="password-input" data-test="password-input" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.75rem; color: var(--danger);"></span>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;" id="login-btn" data-test="login-submit">
                Sign In
            </button>
        </form>
        
        <p style="text-align: center; margin-top: 1.5rem; color: var(--text-muted); font-size: 0.875rem;">
            Don't have an account? <a asp-action="Register" style="color: var(--primary); text-decoration: none;">Register here</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
