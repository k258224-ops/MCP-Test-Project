@model TaskFlowPro.Web.Models.TaskItem
@{
    ViewData["Title"] = "Edit Task";
}

<div class="card" style="max-width: 600px; margin: 0 auto;">
    <form asp-action="Edit" method="post" id="edit-task-form">
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group">
            <label asp-for="Title" class="form-label">Task Title</label>
            <input asp-for="Title" class="form-control" data-test="task-title-input" />
            <span asp-validation-for="Title" class="text-danger" style="font-size: 0.75rem; color: var(--danger);"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" data-test="task-desc-input"></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<TaskFlowPro.Web.Models.TaskStatus>()" data-test="task-status-select"></select>
            </div>
            <div class="form-group">
                <label asp-for="Priority" class="form-label">Priority</label>
                <select asp-for="Priority" class="form-control" asp-items="Html.GetEnumSelectList<TaskFlowPro.Web.Models.TaskPriority>()" data-test="task-priority-select"></select>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="DueDate" class="form-label">Due Date</label>
            <input asp-for="DueDate" type="date" class="form-control" data-test="task-due-date" />
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;" id="update-task-btn" data-test="save-task">Update Task</button>
            <a asp-action="Index" class="btn btn-outline" style="flex: 1; text-align: center;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
