@model IEnumerable<TaskFlowPro.Web.Models.TaskItem>
@{
    ViewData["Title"] = "My Tasks";
}

<div class="card" style="margin-bottom: 2rem;">
    <form method="get" asp-action="Index" id="filter-form" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
        <div class="form-group" style="flex: 1; min-width: 200px; margin-bottom: 0;">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search tasks..." data-test="search-input" />
        </div>
        <div class="form-group" style="width: 150px; margin-bottom: 0;">
            <label class="form-label">Status</label>
            <select name="status" class="form-control" data-test="status-filter">
                <option value="">All</option>
                <option value="Pending" selected="@(ViewBag.Status?.ToString() == "Pending")">Pending</option>
                <option value="Completed" selected="@(ViewBag.Status?.ToString() == "Completed")">Completed</option>
            </select>
        </div>
        <div class="form-group" style="width: 150px; margin-bottom: 0;">
            <label class="form-label">Priority</label>
            <select name="priority" class="form-control" data-test="priority-filter">
                <option value="">All</option>
                <option value="Low" selected="@(ViewBag.Priority?.ToString() == "Low")">Low</option>
                <option value="Medium" selected="@(ViewBag.Priority?.ToString() == "Medium")">Medium</option>
                <option value="High" selected="@(ViewBag.Priority?.ToString() == "High")">High</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary" id="filter-btn">Filter</button>
        <a asp-action="Index" class="btn btn-outline" id="clear-btn">Clear</a>
        <a asp-action="Create" class="btn btn-primary" style="margin-left: auto;" id="create-task-btn" data-test="create-task">
            <i class="fas fa-plus"></i> New Task
        </a>
    </form>
</div>

<div class="card">
    @if (Model.Any())
    {
        <table class="task-list">
            <thead>
                <tr style="text-align: left; color: var(--text-muted);">
                    <th></th>
                    <th>Task Details</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr class="task-item" data-test="task-row-@task.Id">
                        <td style="width: 50px;">
                            <form asp-action="ToggleStatus" asp-route-id="@task.Id" method="post">
                                <button type="submit" class="btn-check" style="background: none; border: none; cursor: pointer; color: @(task.Status == TaskFlowPro.Web.Models.TaskStatus.Completed ? "var(--success)" : "var(--border)")" data-test="toggle-task-@task.Id">
                                    <i class="fa-2x @(task.Status == TaskFlowPro.Web.Models.TaskStatus.Completed ? "fas fa-check-square" : "far fa-square")"></i>
                                </button>
                            </form>
                        </td>
                        <td>
                            <div style="font-weight: 600; text-decoration: @(task.Status == TaskFlowPro.Web.Models.TaskStatus.Completed ? "line-through" : "none"); color: @(task.Status == TaskFlowPro.Web.Models.TaskStatus.Completed ? "var(--text-muted)" : "white")">
                                @task.Title
                            </div>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">@task.Description</div>
                        </td>
                        <td>
                            <span class="badge badge-@task.Priority.ToString().ToLower()">@task.Priority</span>
                        </td>
                        <td style="font-size: 0.875rem;">
                            @(task.DueDate?.ToShortDateString() ?? "No date")
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.5rem;">
                                <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-outline btn-sm" style="padding: 0.4rem;" data-test="edit-task-@task.Id">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@task.Id" method="post" onsubmit="return confirm('Are you sure?')">
                                    <button type="submit" class="btn btn-danger btn-sm" style="padding: 0.4rem;" data-test="delete-task-@task.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 3rem;" id="no-tasks-message">
            <p style="color: var(--text-muted);">No tasks found matching your criteria.</p>
        </div>
    }
</div>
