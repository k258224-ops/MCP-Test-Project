<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskFlow Pro</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="toast-container"></div>

    <div class="app-container">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="sidebar">
                <div class="logo">
                    <i class="fas fa-layer-group"></i>
                    <span>TaskFlow Pro</span>
                </div>
                <ul class="nav-links">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" id="nav-dashboard">
                            <i class="fas fa-chart-pie"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Tasks" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tasks" ? "active" : "")" id="nav-tasks">
                            <i class="fas fa-tasks"></i>
                            <span>My Tasks</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Account" asp-action="Profile" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" id="nav-profile">
                            <i class="fas fa-user-circle"></i>
                            <span>Profile</span>
                        </a>
                    </li>
                </ul>
                <div class="nav-footer">
                    <a asp-controller="Account" asp-action="Logout" class="nav-link" id="logout-btn">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </aside>
        }

        <main class="main-content" style="@(User.Identity?.IsAuthenticated == true ? "" : "margin-left: 0;")">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <header>
                    <h1 id="page-title">@ViewData["Title"]</h1>
                    <div class="user-meta">
                        <span id="user-display-name">Welcome, @User.Identity.Name</span>
                    </div>
                </header>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>showToast('@TempData["SuccessMessage"]', 'success');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>showToast('@TempData["ErrorMessage"]', 'error');</text>
        }
    </script>
</body>
</html>
